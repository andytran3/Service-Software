# Copy to .env and adjust if needed. These values are for local development only.

# PostgreSQL container (docker-compose.yml)
POSTGRES_USER=requests
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=requests_dev
POSTGRES_PORT=5432

# Development database used by the server and `npm run db:migrate`
DATABASE_URL=postgresql://requests:change-me-local-only@localhost:5432/requests_dev

# Isolated test database used only by automated tests and `npm run db:migrate:test`.
# The database name must end in _test and differ from the development database.
DATABASE_URL_TEST=postgresql://requests:change-me-local-only@localhost:5432/requests_test

# Express server port (the Vite dev server proxies /api to it)
PORT=3000
